---
import { METRICS_BAR } from '../data/doctorData';
---

<section aria-label="Credenciales y Métricas Principales" class="relative z-10 bg-medical-900 text-white py-8 sm:py-10 border-y border-medical-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {METRICS_BAR.map((item) => (
        <div class="flex items-start gap-4 p-4 rounded-2xl bg-medical-950/40 border border-medical-800/80 hover:border-medical-500/60 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-medical-800/90 text-medical-300 flex items-center justify-center shrink-0 shadow-sm">
            {item.icon === "shield-check" && (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
            {item.icon === "sparkles" && (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
            {item.icon === "activity" && (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            )}
            {item.icon === "hospital" && (
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            )}
          </div>
          <div>
            <h2 class="font-heading font-bold text-base text-white leading-snug">
              {item.title}
            </h2>
            <p class="text-xs sm:text-sm text-medical-200 mt-1 leading-relaxed">
              {item.subtitle}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
