---
import { TRUST_BADGES } from '../data/doctorData';
---

<section
  id="inicio"
  class="relative overflow-hidden bg-gradient-to-br from-slate-50 via-medical-50/70 to-white pt-10 pb-16 lg:pt-16 lg:pb-24"
>
  <!-- Subtle clinical background grid & radial glow -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-medical-200/40 blur-3xl"></div>
    <div class="absolute bottom-0 left-10 w-80 h-80 rounded-full bg-tealMed-100/50 blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Column: Copy, Trust Badges & Dual CTAs (7 cols on desktop) -->
      <div class="lg:col-span-7 text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-medical-100/90 border border-medical-200 text-medical-800 text-xs sm:text-sm font-semibold mb-5">
          <span class="w-2 h-2 rounded-full bg-tealMed-500 animate-ping"></span>
          <span>Atención Especializada en San Pedro Sula, Cortés</span>
        </div>

        <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-medical-950 tracking-tight leading-[1.15] mb-5">
          Dr. Erick Ponce <span class="text-medical-600 font-bold">|</span>{" "}
          <span class="bg-gradient-to-r from-medical-800 via-medical-600 to-tealMed-600 bg-clip-text text-transparent">
            Cirujano Ortopeda y Traumatólogo en San Pedro Sula
          </span>
        </h1>

        <p class="text-base sm:text-lg lg:text-xl text-slate-600 leading-relaxed mb-7 max-w-2xl">
          Especialista en <strong>Artroscopia</strong>, <strong>Medicina Deportiva</strong> y <strong>Manejo Integral de Fracturas</strong>. Restauramos tu movilidad con tratamientos quirúrgicos y conservadores de mínima invasión.
        </p>

        <!-- Trust Badges (UNAH-VS | Especialidad en Guatemala | Fellowship en Argentina) -->
        <div class="mb-8">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2.5">
            Respaldo Académico Internacional
          </p>
          <div class="flex flex-wrap items-center gap-2.5">
            {TRUST_BADGES.map((badge) => (
              <div class="inline-flex items-center gap-2 bg-white px-3.5 py-2 rounded-xl border border-slate-200/90 shadow-sm">
                <svg class="w-4 h-4 text-medical-600 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <div class="text-xs sm:text-sm">
                  <span class="font-bold text-medical-950">{badge.short}</span>
                  <span class="hidden sm:inline text-slate-500"> · {badge.label}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Dual CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4">
          <a
            href="#contacto-seguro"
            data-protected-contact="whatsapp"
            data-wa-api="true"
            data-wa-text="Hola Dr. Erick Ponce, quisiera agendar una consulta médica en San Pedro Sula."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 bg-whatsapp hover:bg-whatsapp-hover text-white font-bold text-base px-7 py-4 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.625.846 5.059 2.284 7.033l-1.492 5.449 5.602-1.469c1.914 1.258 4.205 1.987 6.606 1.987 6.627 0 12-5.373 12-12s-5.373-12-12-12z" />
            </svg>
            <span>Agendar Consulta Médica</span>
          </a>

          <a
            href="#servicios"
            class="inline-flex items-center justify-center gap-2 bg-white hover:bg-medical-50 text-medical-700 font-bold text-base px-7 py-4 rounded-xl border-2 border-medical-600 shadow-sm transition-all duration-200"
          >
            <span>Ver Tratamientos</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Micro-trust note -->
        <div class="mt-6 flex items-center gap-4 text-xs sm:text-sm text-slate-500">
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4 text-tealMed-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Atención previa cita y urgencias traumatológicas
          </span>
          <span class="hidden sm:inline text-slate-300">•</span>
          <span class="hidden sm:inline">Construyendo caminos hacia una movilidad plena</span>
        </div>
      </div>

      <!-- Right Column: Doctor Portrait Image (5 cols on desktop) -->
      <div class="lg:col-span-5 relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="relative rounded-3xl bg-gradient-to-b from-medical-900 to-medical-950 p-2 sm:p-3 shadow-clinical-lg border border-medical-200/60">
          <img
            src="./assets/img/dr-erick-ponce-hero.webp"
            alt="Dr. Erick Ponce - Cirujano Ortopeda y Traumatólogo especialista en artroscopia y fracturas en San Pedro Sula, Honduras"
            width="853"
            height="1113"
            loading="eager"
            fetchpriority="high"
            class="w-full h-auto rounded-2xl object-cover shadow-inner"
          />

          <!-- Floating Clinical Badge Bottom-Left -->
          <div class="absolute -bottom-4 left-4 right-4 sm:left-6 sm:right-6 bg-white/95 backdrop-blur-md p-4 rounded-2xl shadow-clinical border border-slate-100 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-medical-50 text-medical-700 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-medical-600">
                  Ortopedia &amp; Traumatología
                </p>
                <p class="text-sm font-extrabold text-medical-950">
                  Fracturas · Artroscopia · Deporte
                </p>
              </div>
            </div>
            <span class="hidden sm:inline-flex items-center px-2.5 py-1 rounded-lg bg-tealMed-50 text-tealMed-700 text-xs font-bold">
              SPS, HN
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
