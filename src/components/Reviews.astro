---
import reviewsData from '../data/reviews.json';

const { googleProfileUrl, averageRating, totalReviews, reviews } = reviewsData;
---

<section id="opiniones" aria-label="Opiniones y testimonios de pacientes" class="py-16 lg:py-24 bg-white border-t border-slate-200/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header with Trust & Rating Badge -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-medical-50 text-medical-800 text-xs font-bold uppercase tracking-wider mb-4 border border-medical-200/60 shadow-xs">
        <svg class="w-3.5 h-3.5 fill-amber-400 text-amber-400" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span>Testimonios de Pacientes</span>
      </div>

      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-medical-950 tracking-tight">
        La confianza de quienes han recuperado su{" "}
        <span class="text-medical-600">movilidad y bienestar</span>
      </h2>

      <p class="mt-3.5 text-base sm:text-lg text-slate-600 leading-relaxed">
        Historias reales y experiencias de pacientes atendidos por el Dr. Erick Ponce en San Pedro Sula y el Valle de Sula.
      </p>

      <!-- Google Rating Summary Pill -->
      <div class="mt-7 inline-flex flex-wrap items-center justify-center gap-3 bg-slate-50 border border-slate-200 px-5 py-3 rounded-2xl shadow-xs">
        <div class="flex items-center gap-2">
          <!-- Google 'G' Multi-color SVG -->
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
          </svg>
          <span class="font-heading font-extrabold text-slate-900 text-lg leading-none">
            {averageRating.toFixed(1)}
          </span>
        </div>

        <div class="flex items-center text-amber-400 gap-0.5" role="img" aria-label={`Calificación promedio: ${averageRating.toFixed(1)} de 5 estrellas`}>
          {Array.from({ length: 5 }).map(() => (
            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>

        <span class="text-xs sm:text-sm font-medium text-slate-700">
          Basado en <strong>{totalReviews} opiniones verificadas</strong> en Google Reviews
        </span>
      </div>
    </div>

    <!-- Responsive Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 items-stretch">
      {reviews.map((rev) => (
        <article class="bg-slate-50/70 hover:bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-7 shadow-xs hover:shadow-clinical hover:border-medical-300/80 transition-all duration-200 flex flex-col justify-between">
          <div>
            <!-- Review Top: Avatar, Name, Badge & Date -->
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-medical-100 text-medical-800 font-bold flex items-center justify-center text-sm border border-medical-200 shrink-0 shadow-xs">
                  {rev.initials || rev.author.substring(0, 2).toUpperCase()}
                </div>
                <div>
                  <h3 class="font-heading font-bold text-slate-900 text-base leading-tight">
                    {rev.author}
                  </h3>
                  <div class="flex items-center gap-1.5 mt-0.5">
                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200/80 px-2 py-0.5 rounded-full">
                      <svg class="w-3 h-3 fill-current text-emerald-600" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                      Verificado en Google
                    </span>
                  </div>
                </div>
              </div>

              <!-- Source / Date -->
              {rev.displayDate && (
                <span class="text-xs text-slate-400 font-medium shrink-0">
                  {rev.displayDate}
                </span>
              )}
            </div>

            <!-- Stars Rating -->
            <div class="flex items-center gap-1 mb-3.5" role="img" aria-label={`Calificación: ${rev.rating} de 5 estrellas`}>
              {Array.from({ length: rev.rating }).map(() => (
                <svg class="w-4 h-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <!-- Review Body -->
            <blockquote class="text-slate-700 text-sm sm:text-base leading-relaxed italic">
              "{rev.comment}"
            </blockquote>
          </div>

          <!-- Doctor Owner Response (if present) -->
          {rev.ownerReply && (
            <div class="mt-5 pt-3 border-t border-slate-200/70">
              <div class="bg-medical-50/70 border-l-4 border-medical-600 rounded-r-xl p-3.5">
                <div class="flex items-center gap-2 mb-1.5">
                  <svg class="w-4 h-4 text-medical-700 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-xs font-bold text-medical-950">
                    Respuesta del especialista: {rev.ownerReply.author}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-slate-700 leading-normal">
                  "{rev.ownerReply.text}"
                </p>
              </div>
            </div>
          )}
        </article>
      ))}
    </div>

    <!-- Bottom Actions: Prominent Accessible CTA to Google Profile -->
    <div class="mt-12 sm:mt-16 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center justify-center gap-4 bg-slate-50 border border-slate-200/90 rounded-2xl p-6 sm:p-8 max-w-3xl mx-auto shadow-xs">
        <div class="text-center sm:text-left">
          <p class="font-heading font-bold text-base sm:text-lg text-medical-950">
            ¿Ya tuviste tu consulta médica con el Dr. Erick Ponce?
          </p>
          <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-xl">
            Tu testimonio ayuda a otros pacientes a tomar decisiones informadas sobre su salud ortopédica en San Pedro Sula y el Valle de Sula.
          </p>
        </div>

        <a
          href={googleProfileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 inline-flex items-center gap-2.5 bg-medical-700 hover:bg-medical-800 text-white font-semibold text-sm sm:text-base px-6 py-3.5 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-medical-500 focus:ring-offset-2"
          aria-label="Ver todas las opiniones o calificar al Dr. Erick Ponce en Google Reviews (se abre en nueva pestaña)"
        >
          <!-- Google 'G' Multi-color SVG -->
          <span class="w-5 h-5 rounded-full bg-white p-0.5 flex items-center justify-center shrink-0">
            <svg class="w-full h-full" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
            </svg>
          </span>
          <span>Ver opiniones o calificar en Google</span>
          <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

  </div>
</section>
