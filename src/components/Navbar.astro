---
import { Image } from 'astro:assets';
import logoImg from '../assets/img/logo-ep.webp';

const navLinks = [
  { label: "Inicio", href: "#inicio" },
  { label: "Conoce al Dr. Erick Ponce", href: "#especialista" },
  { label: "Servicios", href: "#servicios" },
  { label: "Preguntas", href: "#preguntas" },
  { label: "Contacto", href: "#contacto" },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-sm transition-all">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Navegación Principal">
    <div class="flex items-center justify-between h-20">
      <!-- Brand / Logo -->
      <a href="#inicio" class="flex items-center gap-3 group focus:outline-none">
        <div class="w-12 h-12 rounded-xl overflow-hidden bg-[#04566e] flex items-center justify-center shadow-md group-hover:scale-105 transition-transform border border-medical-200/60">
          <Image
            src={logoImg}
            alt="Logo Oficial Dr. Erick Ponce Ortopeda y Traumatólogo en San Pedro Sula"
            title="Dr. Erick Ponce - Ortopedia y Traumatología"
            width={92}
            height={70}
            class="w-full h-full object-contain p-1"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-extrabold text-base sm:text-lg text-medical-950 tracking-tight leading-tight">
            Dr. Erick Ponce
          </span>
          <span class="text-xs sm:text-sm font-medium text-medical-600 leading-tight">
            Ortopedia &amp; Traumatología
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <div class="hidden lg:flex items-center gap-7">
        {navLinks.map((item) => (
          <a
            href={item.href}
            class="text-sm font-semibold text-slate-700 hover:text-medical-600 transition-colors py-2 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-medical-600 hover:after:w-full after:transition-all"
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Desktop CTA Button -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href="#contacto-seguro"
          data-protected-contact="whatsapp"
          data-wa-api="true"
          data-wa-text="Hola Dr. Erick Ponce, quisiera agendar una cita médica en San Pedro Sula."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-whatsapp hover:bg-whatsapp-hover text-white font-semibold text-sm px-5 py-2.5 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.625.846 5.059 2.284 7.033l-1.492 5.449 5.602-1.469c1.914 1.258 4.205 1.987 6.606 1.987 6.627 0 12-5.373 12-12s-5.373-12-12-12z" />
          </svg>
          <span>Agendar Cita</span>
        </a>
      </div>

      <!-- Mobile Hamburger Toggle Button -->
      <div class="flex lg:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú de navegación"
          class="inline-flex items-center justify-center p-2.5 rounded-xl text-medical-900 hover:bg-medical-50 focus:outline-none focus:ring-2 focus:ring-medical-500 transition-colors"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobile-menu" class="hidden lg:hidden pb-5 pt-2 border-t border-slate-100">
      <div class="flex flex-col space-y-1.5">
        {navLinks.map((item) => (
          <a
            href={item.href}
            class="px-3 py-2.5 rounded-lg text-base font-semibold text-slate-700 hover:bg-medical-50 hover:text-medical-700 transition-colors"
          >
            {item.label}
          </a>
        ))}
        <div class="pt-3 mt-2 border-t border-slate-100 flex flex-col gap-2.5">
          <a
            href="#contacto-seguro"
            data-protected-contact="whatsapp"
            data-wa-api="true"
            data-wa-text="Hola Dr. Erick Ponce, quisiera agendar una cita médica en San Pedro Sula."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 bg-whatsapp hover:bg-whatsapp-hover text-white font-semibold text-base px-5 py-3 rounded-xl shadow-md transition-colors"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771z" />
            </svg>
            <span>Agendar Cita por WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>
