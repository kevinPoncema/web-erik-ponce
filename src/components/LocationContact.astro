---
import { CLINIC_LOCATIONS, DOCTOR_INFO, SERVICES_LIST } from '../data/doctorData';
---

<section id="contacto" class="py-16 lg:py-24 bg-white border-t border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Title -->
    <div class="max-w-3xl mx-auto text-center mb-12 lg:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-medical-100 text-medical-800 text-xs font-bold uppercase tracking-wider mb-3">
        <span>Ubicación, Citas y Cobertura Regional</span>
      </div>
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-medical-950 tracking-tight">
        Atención Ortopédica en <span class="text-medical-600">San Pedro Sula y Alrededores</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        Consulta médica especializada y procedimientos quirúrgicos <strong>previa cita</strong> en centros hospitalarios de San Pedro Sula (<strong>Hospital Betesda</strong>, <strong>Clínica Fe y Esperanza</strong>, <strong>Hospital Militar Regional del Norte</strong> y centros aliados), con atención y accesibilidad para pacientes de <strong>Choloma, Villanueva, El Progreso, La Lima, Puerto Cortés y todo el Valle de Sula</strong>.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-2 mt-4 text-xs font-medium text-slate-500">
        <span class="font-bold text-medical-800">Zona de Cobertura:</span>
        <span class="px-2.5 py-0.5 rounded-full bg-slate-100 border border-slate-200 text-slate-800 font-medium">San Pedro Sula</span>
        <span class="px-2.5 py-0.5 rounded-full bg-slate-100 border border-slate-200 text-slate-800 font-medium">Choloma</span>
        <span class="px-2.5 py-0.5 rounded-full bg-slate-100 border border-slate-200 text-slate-800 font-medium">Villanueva</span>
        <span class="px-2.5 py-0.5 rounded-full bg-slate-100 border border-slate-200 text-slate-800 font-medium">El Progreso</span>
        <span class="px-2.5 py-0.5 rounded-full bg-slate-100 border border-slate-200 text-slate-800 font-medium">La Lima</span>
        <span class="px-2.5 py-0.5 rounded-full bg-slate-100 border border-slate-200 text-slate-800 font-medium">Puerto Cortés</span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left Column: Clinics, Protected Contact Info & Anti-Spam Quick Booking Form (7 cols) -->
      <div class="lg:col-span-7 space-y-8">
        <!-- Hospitals & Clinics Cards -->
        <div class="bg-slate-50 rounded-2xl p-6 sm:p-7 border border-slate-200/90">
          <h3 class="font-heading text-lg font-extrabold text-medical-950 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-medical-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            <span>Centros de Atención en San Pedro Sula</span>
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {CLINIC_LOCATIONS.map((loc) => (
              <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-sm">
                <p class="font-heading font-bold text-sm text-medical-950">{loc.name}</p>
                <p class="text-xs font-semibold text-tealMed-700 mt-0.5">{loc.area}</p>
                <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">{loc.type}</p>
              </div>
            ))}
          </div>
          <p class="text-xs text-slate-500 mt-4 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-medical-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span><strong>Horarios:</strong> Consultas de Lunes a Sábado previa programación. Urgencias por fracturas y trauma 24/7.</span>
          </p>
        </div>

        <!-- Anti-Bot Protected Direct Contact Form -> WhatsApp -->
        <div class="bg-medical-950 text-white rounded-3xl p-6 sm:p-8 shadow-clinical-lg border border-medical-800">
          <div class="mb-6">
            <span class="text-xs font-bold uppercase tracking-wider text-tealMed-400">
              ¿Listo para recuperar tu movilidad?
            </span>
            <h3 class="font-heading text-xl sm:text-2xl font-extrabold text-white mt-1">
              Solicita tu Cita Médica Hoy Mismo
            </h3>
            <p class="text-xs sm:text-sm text-medical-200 mt-1">
              Completa tus datos básicos para enviarte de forma segura al WhatsApp oficial del Dr. Erick Ponce.
            </p>
          </div>

          <form id="quick-appointment-form" class="space-y-4" novalidate>
            <!-- Honeypot field against spam bots (hidden from humans & screen readers) -->
            <div class="hp-field" aria-hidden="true">
              <label for="website_hp">No llenar este campo</label>
              <input type="text" id="website_hp" name="website_hp" tabindex="-1" autocomplete="off" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="patient_name" class="block text-xs font-semibold text-medical-200 mb-1.5">
                  Nombre del Paciente *
                </label>
                <input
                  type="text"
                  id="patient_name"
                  name="patient_name"
                  required
                  placeholder="Ej. María Fernández"
                  class="w-full px-4 py-3 rounded-xl bg-medical-900/90 border border-medical-700 text-white placeholder-medical-400 text-sm focus:outline-none focus:ring-2 focus:ring-tealMed-500"
                />
              </div>
              <div>
                <label for="patient_phone" class="block text-xs font-semibold text-medical-200 mb-1.5">
                  Teléfono / Celular *
                </label>
                <input
                  type="tel"
                  id="patient_phone"
                  name="patient_phone"
                  required
                  placeholder="Ej. +504 9999-9999"
                  class="w-full px-4 py-3 rounded-xl bg-medical-900/90 border border-medical-700 text-white placeholder-medical-400 text-sm focus:outline-none focus:ring-2 focus:ring-tealMed-500"
                />
              </div>
            </div>

            <div>
              <label for="patient_service" class="block text-xs font-semibold text-medical-200 mb-1.5">
                Motivo de Consulta o Especialidad
              </label>
              <select
                id="patient_service"
                name="patient_service"
                class="w-full px-4 py-3 rounded-xl bg-medical-900/90 border border-medical-700 text-white text-sm focus:outline-none focus:ring-2 focus:ring-tealMed-500"
              >
                {SERVICES_LIST.map((s) => (
                  <option value={s.title}>{s.title}</option>
                ))}
                <option value="Segunda Opinión / Valoración Quirúrgica">Segunda Opinión / Valoración Quirúrgica</option>
              </select>
            </div>

            <div>
              <label for="patient_notes" class="block text-xs font-semibold text-medical-200 mb-1.5">
                Síntoma principal o clínica de preferencia (Opcional)
              </label>
              <textarea
                id="patient_notes"
                name="patient_notes"
                rows="2"
                placeholder="Ej. Dolor en rodilla derecha al caminar, preferencia Hospital Betesda..."
                class="w-full px-4 py-2.5 rounded-xl bg-medical-900/90 border border-medical-700 text-white placeholder-medical-400 text-sm focus:outline-none focus:ring-2 focus:ring-tealMed-500"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full inline-flex items-center justify-center gap-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-sm sm:text-base px-6 py-3.5 rounded-xl shadow-lg transition-all duration-200"
            >
              <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771z" />
              </svg>
              <span>Enviar Solicitud por WhatsApp</span>
            </button>
          </form>
        </div>
      </div>

      <!-- Right Column: Direct Contact Card & Styled Google Maps Embed (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Contact Details Card -->
        <div class="bg-slate-50 rounded-2xl p-6 sm:p-7 border border-slate-200/90 shadow-clinical space-y-5">
          <h3 class="font-heading text-lg font-extrabold text-medical-950">
            Canales Oficiales de Contacto
          </h3>

          <div class="space-y-4">
            <!-- Phone / WhatsApp -->
            <a
              href="#contacto-seguro"
              data-protected-contact="whatsapp"
              data-wa-api="true"
              data-wa-text="Hola Dr. Erick Ponce, me comunico desde su página web para agendar una consulta."
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-3.5 p-3.5 rounded-xl bg-white border border-slate-200 hover:border-whatsapp transition-colors group"
            >
              <div class="w-10 h-10 rounded-xl bg-whatsapp/10 text-whatsapp-dark flex items-center justify-center shrink-0 group-hover:bg-whatsapp group-hover:text-white transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">WhatsApp y Llamadas</p>
                <p class="text-base font-extrabold text-medical-950" data-obf-phone>+504 3191&#8203;-3419</p>
                <p class="text-xs text-tealMed-700 font-medium mt-0.5">Clic para iniciar chat directo →</p>
              </div>
            </a>

            <!-- Email -->
            <a
              href="#contacto-seguro"
              data-protected-contact="email"
              class="flex items-start gap-3.5 p-3.5 rounded-xl bg-white border border-slate-200 hover:border-medical-500 transition-colors group"
            >
              <div class="w-10 h-10 rounded-xl bg-medical-50 text-medical-700 flex items-center justify-center shrink-0 group-hover:bg-medical-700 group-hover:text-white transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Correo Electrónico</p>
                <p class="text-sm sm:text-base font-bold text-medical-950 break-all" data-obf-email>eponce2290&#8203;@hotmail.com</p>
                <p class="text-xs text-slate-500 mt-0.5">Protegido contra spam automatizado</p>
              </div>
            </a>

            <!-- Instagram -->
            <a
              href={DOCTOR_INFO.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-3.5 p-3.5 rounded-xl bg-white border border-slate-200 hover:border-pink-500 transition-colors group"
            >
              <div class="w-10 h-10 rounded-xl bg-pink-50 text-pink-600 flex items-center justify-center shrink-0 group-hover:bg-pink-600 group-hover:text-white transition-colors">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Instagram Educativo</p>
                <p class="text-sm sm:text-base font-bold text-medical-950">{DOCTOR_INFO.instagramHandle}</p>
                <p class="text-xs text-slate-500 mt-0.5">Consejos sobre fracturas, artrosis y deporte</p>
              </div>
            </a>

            <!-- Doctores de Honduras Directory -->
            <a
              href={DOCTOR_INFO.doctoresDeHondurasUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-3.5 p-3.5 rounded-xl bg-white border border-slate-200 hover:border-medical-600 transition-colors group"
            >
              <div class="w-10 h-10 rounded-xl bg-tealMed-50 text-tealMed-700 flex items-center justify-center shrink-0 group-hover:bg-tealMed-600 group-hover:text-white transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Directorio Médico Oficial</p>
                <p class="text-sm sm:text-base font-bold text-medical-950">Doctores de Honduras (#1144)</p>
                <p class="text-xs text-slate-500 mt-0.5">Perfil profesional verificado en Honduras</p>
              </div>
            </a>
          </div>
        </div>

        <!-- Styled Google Maps Embed (San Pedro Sula, Cortés, Honduras) -->
        <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-clinical bg-slate-100">
          <div class="px-4 py-2.5 bg-medical-900 text-white text-xs font-semibold flex items-center justify-between">
            <span>📍 Zona de Cobertura Médica: San Pedro Sula, Cortés</span>
            <span class="text-medical-200">CP 211101</span>
          </div>
          <iframe
            title="Mapa de ubicación de consulta del Dr. Erick Ponce en San Pedro Sula, Cortés, Honduras"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d61514.53937781379!2d-88.0594299!3d15.50417!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f665b00923d691f%3A0x8032b8d552b29b8!2sSan%20Pedro%20Sula%2C%20Cort%C3%A9s%2C%20Honduras!5e0!3m2!1ses!2shn!4v1710000000000!5m2!1ses!2shn"
            width="100%"
            height="250"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-60 object-cover"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
