---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import MetricsBar from '../components/MetricsBar.astro';
import AboutSpecialist from '../components/AboutSpecialist.astro';
import Services from '../components/Services.astro';
import PatientResources from '../components/PatientResources.astro';
import LocationContact from '../components/LocationContact.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
---

<Layout
  title="Dr. Erick Ponce | Ortopeda y Traumatólogo en San Pedro Sula y Alrededores"
  description="Consulta con el Dr. Erick Ponce en San Pedro Sula y todo el Valle de Sula (Choloma, Villanueva, El Progreso, La Lima). Especialista en Ortopedia, Traumatología, artroscopia de rodilla, fracturas y manguito rotador. Agenda al +504 3191-3419."
>
  <TopBar />
  <Navbar />
  <main id="contenido-principal">
    <Hero />
    <MetricsBar />
    <AboutSpecialist />
    <Services />
    <PatientResources />
    <LocationContact />
    <Faq />
  </main>
  <Footer />
  <WhatsAppFab />
</Layout>
